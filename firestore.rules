rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(orgId) {
      return signedIn() && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }
    function member(orgId) {
      return signedIn() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }
    function role(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role;
    }
    function manages(orgId) { return owner(orgId) || (member(orgId) && role(orgId) == 'admin'); }
    function operates(orgId) { return manages(orgId) || (member(orgId) && role(orgId) == 'developer'); }
    function project(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }
    function readsProject(projectId) {
      return signedIn() && project(projectId).lifecycle == 'active' && member(project(projectId).orgId);
    }
    function operatesProject(projectId) { return readsProject(projectId) && operates(project(projectId).orgId); }
    function managesProject(projectId) { return readsProject(projectId) && manages(project(projectId).orgId); }
    function serverProject(serverId) { return get(/databases/$(database)/documents/servers/$(serverId)).data.projectId; }
    function validRole(value) { return value in ['admin', 'developer', 'viewer']; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid && request.resource.data.email == request.auth.token.email;
    }
    match /organizations/{orgId} {
      allow read: if member(orgId) || owner(orgId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.plan == 'free';
      allow update: if manages(orgId) && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'inviteCode', 'billingEmail', 'updatedAt']);
      // Organization deletion needs a server-side cleanup workflow.
      allow delete: if false;
    }
    match /organizations/{orgId}/members/{uid} {
      allow read: if member(orgId) || owner(orgId);
      allow create: if owner(orgId) && request.resource.data.uid == uid &&
        ((uid == request.auth.uid && request.resource.data.role == 'owner') || validRole(request.resource.data.role));
      allow update: if request.resource.data.uid == resource.data.uid && (
        (manages(orgId) && uid != get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId
          && validRole(request.resource.data.role) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'serverScope', 'lastActivity'])) ||
        (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastActivity']))
      );
      allow delete: if manages(orgId) && uid != get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId;
    }
    // A single authoritative project-to-organization binding prevents another
    // organization from claiming the same project ID. Create both docs atomically.
    match /projects/{projectId} {
      allow read: if member(resource.data.orgId) || owner(resource.data.orgId);
      allow create: if manages(request.resource.data.orgId) && request.resource.data.keys().hasOnly(['orgId', 'lifecycle'])
        && request.resource.data.lifecycle == 'active'
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)/projects/$(projectId)).data.id == projectId;
      allow update, delete: if false;
    }
    match /organizations/{orgId}/projects/{projectId} {
      allow read: if member(orgId) || owner(orgId);
      allow create: if manages(orgId) && request.resource.data.id == projectId && request.resource.data.orgId == orgId
        && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.orgId == orgId
        && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.lifecycle == 'active';
      allow update: if manages(orgId) && project(projectId).lifecycle == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'environment']);
      allow delete: if false;
    }
    match /organizations/{orgId}/invites/{inviteId} {
      allow read: if manages(orgId) || (signedIn() && request.auth.token.email == resource.data.email);
      // Creation and acceptance are authenticated API transactions. Recipients
      // cannot alter the role, token, address, or replay an accepted invitation.
      allow create, update: if false;
      allow delete: if manages(orgId);
    }
    match /projects/{projectId}/metrics/{metricId} {
      allow read: if readsProject(projectId);
      allow write: if false;
    }
    match /projects/{projectId}/logs/{logId} {
      allow read: if readsProject(projectId);
      allow write: if false;
    }
    match /projects/{projectId}/alerts/{alertId} {
      allow read: if readsProject(projectId);
      allow create, delete: if false;
      allow update: if operatesProject(projectId) && request.resource.data.status in ['active', 'acknowledged', 'resolved']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acknowledgedBy', 'acknowledgedAt', 'resolvedBy', 'resolvedAt']);
    }
    match /projects/{projectId}/integrations/{integrationId} {
      allow read: if readsProject(projectId);
      allow write: if operatesProject(projectId);
    }
    match /projects/{projectId}/alert_rules/{ruleId} {
      allow read: if readsProject(projectId);
      allow write: if operatesProject(projectId);
    }
    match /projects/{projectId}/incidents/{incidentId} {
      allow read: if readsProject(projectId);
      allow create: if operatesProject(projectId) && request.resource.data.projectId == projectId;
      allow update: if operatesProject(projectId) && request.resource.data.projectId == resource.data.projectId;
      allow delete: if managesProject(projectId);
    }
    match /projects/{projectId}/risk_insights/{insightId} {
      allow read: if readsProject(projectId);
      allow create: if operatesProject(projectId) && request.resource.data.projectId == projectId;
      allow update: if operatesProject(projectId) && request.resource.data.projectId == resource.data.projectId;
      allow delete: if managesProject(projectId);
    }
    match /servers/{serverId} {
      allow read: if readsProject(resource.data.projectId);
      allow create: if managesProject(request.resource.data.projectId) && request.resource.data.id == serverId
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100
        && request.resource.data.apiKeyHash is string && request.resource.data.apiKeyHash.size() == 64
        && request.resource.data.status == 'offline' && request.resource.data.apiKeyStatus == 'active'
        && !request.resource.data.keys().hasAny(['apiKey', 'lastSeen']);
      allow update: if managesProject(resource.data.projectId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'hostname', 'os', 'environment', 'description', 'tags', 'status',
          'deletedAt', 'publicStatusEnabled', 'publicName', 'apiKeyHash', 'apiKeyStatus',
          'apiKeyName', 'apiKeyCreatedAt', 'apiKeyRevokedAt', 'apiKeyLastUsed'
        ]) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['apiKeyLastUsed'])
          || (request.resource.data.apiKeyLastUsed == null && request.resource.data.apiKeyHash != resource.data.apiKeyHash));
      allow delete: if false;
    }
    match /servers/{serverId}/metrics/{metricId} {
      allow read: if readsProject(serverProject(serverId));
      allow write: if false;
    }
    match /servers/{serverId}/deep_scans/{scanId} {
      allow read: if readsProject(serverProject(serverId));
      allow write: if false;
    }
    match /servers/{serverId}/audit_logs/{auditId} {
      allow read: if readsProject(serverProject(serverId));
      allow create: if managesProject(serverProject(serverId));
      allow update, delete: if false;
    }
    match /organizations/{orgId}/auditLogs/{auditId} {
      allow read: if manages(orgId);
      allow create: if manages(orgId) && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /projects/{projectId}/auditLogs/{auditId} {
      allow read: if managesProject(projectId);
      allow create: if operatesProject(projectId) && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /joinRequests/{requestId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.userId || manages(resource.data.orgId));
      allow write: if false;
    }
    match /notifications/{notificationId} {
      allow read: if signedIn() && request.auth.uid == resource.data.recipientUserId;
      allow update: if signedIn() && request.auth.uid == resource.data.recipientUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }
  }
}
