# Frontend/client config
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_API_BASE_URL=http://localhost:3000

# Backend Firebase Admin
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_ID=your-database-id
FIREBASE_SERVICE_ACCOUNT_JSON=path-to-service-account-json
GOOGLE_SERVICE_ACCOUNT_JSON=path-to-service-account-json

# Email
RESEND_API_KEY=replace-with-resend-api-key
INVITE_FROM_EMAIL=notifications@example.com
ALERT_FROM_EMAIL=alerts@example.com

# App/API
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
API_KEY_HASH_SECRET=replace-with-a-long-random-secret

# Optional GitHub collaborator workflow
GITHUB_PAT=replace-with-github-token
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-github-repository
